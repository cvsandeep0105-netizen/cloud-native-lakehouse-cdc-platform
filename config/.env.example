# Project 02 — Environment Variable Template

# Runtime
PROJECT02_ENV=local
PROJECT02_LOG_LEVEL=INFO

# PostgreSQL
PROJECT02_POSTGRES_HOST=localhost
PROJECT02_POSTGRES_PORT=5432
PROJECT02_POSTGRES_DB=postgres
PROJECT02_POSTGRES_USER=postgres
PROJECT02_POSTGRES_PASSWORD=<SET_SECURELY>

# AWS
PROJECT02_AWS_REGION=<SET_FOR_AWS_EXECUTION>
PROJECT02_AWS_ACCOUNT_ID=<SET_FOR_AWS_EXECUTION>

# S3 Data Lake
PROJECT02_S3_BUCKET=<SET_FOR_AWS_EXECUTION>
PROJECT02_S3_PREFIX=<SET_FOR_AWS_EXECUTION>

# Spark
PROJECT02_SPARK_MASTER=local[2]
PROJECT02_SPARK_APP_NAME=project02-lakehouse

# Processing
PROJECT02_CHECKPOINT_PREFIX=<SET_PER_ENVIRONMENT>
PROJECT02_DQ_FAILURE_THRESHOLD=<SET_PER_PIPELINE>
