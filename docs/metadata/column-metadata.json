{
  "orders": {
    "order_id": {
      "role": "primary_key",
      "business_definition": "Unique order identifier",
      "nullable": false
    },
    "customer_id": {
      "role": "foreign_key",
      "business_definition": "Customer associated with the order",
      "nullable": false
    },
    "order_status": {
      "role": "business_attribute",
      "business_definition": "Current lifecycle status of the order",
      "nullable": false
    },
    "order_purchase_timestamp": {
      "role": "event_timestamp",
      "business_definition": "Timestamp when the order was placed",
      "nullable": false
    },
    "order_delivered_customer_date": {
      "role": "event_timestamp",
      "business_definition": "Timestamp when the order was delivered to the customer",
      "nullable": true
    },
    "order_estimated_delivery_date": {
      "role": "business_timestamp",
      "business_definition": "Estimated customer delivery date",
      "nullable": false
    }
  },
  "order_items": {
